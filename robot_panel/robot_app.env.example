# Dirección de tu Home Assistant
HA_URL=http://homeassistant.local:8123
# Token de larga duración: HA > tu perfil > Seguridad > Tokens de acceso de larga duración
HA_TOKEN=
# PIN de 4 cifras para abrir el panel (déjalo vacío si solo lo usas en casa)
APP_PIN=
# Prefijo de las entidades del robot (mira el id de lawn_mower.xxx)
ROBOT_PREFIX=robot_cortacesped
PORT=8106
